{
  "name": "d3-force-3d-webgpu",
  "version": "3.2.0",
  "description": "d3-force-3d with a WebGPU compute backend: force-directed graph layout in 1D, 2D or 3D, running on the GPU.",
  "homepage": "https://erw-1.github.io/d3-force-3d-webgpu/",
  "repository": {
    "type": "git",
    "url": "https://github.com/erw-1/d3-force-3d-webgpu.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "layout",
    "network",
    "graph",
    "force",
    "verlet",
    "infovis",
    "3d",
    "webgpu",
    "gpu",
    "compute-shader"
  ],
  "license": "MIT",
  "author": {
    "name": "Vasco Asturiano",
    "url": "https://github.com/vasturiano"
  },
  "type": "module",
  "files": [
    "src/**/*.js",
    "dist/**/*.js"
  ],
  "module": "src/index.js",
  "main": "src/index.js",
  "jsdelivr": "dist/d3-force-3d-webgpu.min.js",
  "unpkg": "dist/d3-force-3d-webgpu.min.js",
  "exports": {
    "umd": "./dist/d3-force-3d-webgpu.min.js",
    "default": "./src/index.js"
  },
  "sideEffects": false,
  "dependencies": {
    "d3-binarytree": "1",
    "d3-dispatch": "1 - 3",
    "d3-octree": "1",
    "d3-quadtree": "1 - 3",
    "d3-timer": "1 - 3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-terser": "^0.4.0",
    "eslint": "^8.33.0",
    "mocha": "^10.2.0",
    "rollup": "^3.14.0",
    "webgpu": "^0.6.1"
  },
  "scripts": {
    "test": "mocha 'test/**/*-test.js' && eslint src test",
    "prepublishOnly": "npm test",
    "prepare": "rollup -c",
    "examples": "node examples/serve.mjs"
  },
  "engines": {
    "node": ">=12"
  }
}
